# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# -------------------------------------------------------------------
# Hugging Face
# -------------------------------------------------------------------
# Your personal access token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here

# Optional: organisation or user namespace for model uploads / fine-tunes
HUGGINGFACE_NAMESPACE=your_username_or_org

# Optional: custom HF Hub endpoint (enterprise mirror etc.)
# HUGGINGFACE_ENDPOINT=https://huggingface.co

# -------------------------------------------------------------------
# JessicAI device identifiers
# -------------------------------------------------------------------
FLIPPER_ZERO_HOST=192.168.1.50
PINEAPPLE_PAGER_HOST=192.168.1.51
RASPBERRY_PI_HOST=192.168.1.52

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/jessicai.log

# -------------------------------------------------------------------
# Model cache
# -------------------------------------------------------------------
MODEL_CACHE_DIR=.cache/models
